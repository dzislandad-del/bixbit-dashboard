{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "seo-workspace",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "app/server.py"
      ],
      "port": 8765,
      "url": "http://127.0.0.1:8765"
    },
    {
      "name": "hub-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        ".hub-build"
      ],
      "port": 8766
    }
  ]
}