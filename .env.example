# Скопируй этот файл в .env и впиши реальные значения.
# .env в .gitignore — НЕ коммить его. Этот .env.example — можно.

# === DataForSEO (живой SERP, объёмы, бэклинки) ===
DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password

# === Google (один service-account JSON на GSC + GA4) ===
# Путь к JSON-ключу. Держи файл ВНЕ репозитория (напр. ~/.secrets/).
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.secrets/bixbit-service-account.json
GSC_SITE_URL=https://bixbit.io/
GA4_PROPERTY_ID=000000000

# === Google PageSpeed / CrUX (Core Web Vitals) ===
PAGESPEED_API_KEY=your_key

# === Web Risk (проверка на malware/phishing; бесплатно до 100k запросов/мес) ===
# СЕЙЧАС НЕ ИСПОЛЬЗУЕТСЯ: нужен платёжный аккаунт Google Cloud, привязка заблокирована (2026-09-29). Оставить пустым.
# Google Cloud → APIs & Services → включить Web Risk API → Credentials → API key (ограничить: Web Risk API)
WEB_RISK_API_KEY=your_key

# === Бэклинки (бесплатные тиры) ===
# Moz API (новый, api.moz.com): один токен из дашборда Moz API → API Tokens
MOZ_API_TOKEN=your_token
# Legacy Moz Links API v2 (только старые аккаунты) — можно не заполнять
MOZ_ACCESS_ID=your_id
MOZ_SECRET_KEY=your_secret
# Bing Webmaster Tools → Settings (⚙) → API Access → Generate API Key
BING_WEBMASTER_API_KEY=your_key

# === Яндекс.Вебмастер (OAuth-токен, права webmaster:hostinfo + webmaster:verify) ===
# oauth.yandex.ru → создать приложение → получить токен (см. docs/agent-knowledge.md)
YANDEX_WEBMASTER_TOKEN=your_token

# === Telegram-алерты (scripts/alerts.py) ===
# @BotFather → /newbot → токен; chat_id — ./scripts/alerts.py --get-chat-id после /start боту
TELEGRAM_BOT_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id
